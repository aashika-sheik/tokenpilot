# Optional database. Defaults to SQLite at ./data/tokenpilot.db
DATABASE_URL=sqlite:///./data/tokenpilot.db

# Optional OpenAI-compatible agent endpoint.
# Works with OpenAI-compatible gateways and local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Production: configure Streamlit OIDC in .streamlit/secrets.toml.
# Never put provider secrets or passwords in source control.
